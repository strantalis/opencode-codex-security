{
  "name": "opencode-codex-security",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.tui.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "test:host": "node scripts/host-test.mjs",
    "test:plan-host": "node scripts/host-plan-test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "test:package": "npm run build && node scripts/packed-host-test.mjs",
    "test:tui": "bun --preload @opentui/solid/preload scripts/tui-preview-smoke.tsx",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "release:artifact": "npm run build && node scripts/release-artifact.mjs",
    "test:runtime": "node --test tests/sdk-runtime.test.mjs"
  },
  "dependencies": {
    "@openai/codex-security": "0.9.1",
    "@opencode/plugin": "2.2.6",
    "smol-toml": "1.9.1",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/cli": "2.2.6",
    "@opentui/core": "0.8.3",
    "@opentui/solid": "0.8.3",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || ^26.0.0"
  },
  "description": "Codex Security scans, policy drafts and finding validation inside OpenCode V2.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strantalis/opencode-codex-security.git"
  },
  "files": [
    "src/",
    "dist/gui-experimental.cjs",
    "dist/tui.js",
    "LICENSE",
    "DISCLOSURE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/AGENT-SETUP.md",
    "docs/CONFIG.md"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
