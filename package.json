{
  "name": "opencode-codex-security",
  "version": "0.1.12",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "bun run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.tui.config.ts",
    "check": "bun run --parallel lint format:check typecheck test",
    "setup:local": "node scripts/setup-local.mjs",
    "test:host": "bun run build && node scripts/host-test.mjs && node scripts/host-plan-test.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "pack:check": "bun run build && node scripts/check-package.mjs",
    "test:package": "bun run build && node scripts/packed-host-test.mjs",
    "test:tui": "bun --preload @opentui/solid/preload scripts/tui-preview-smoke.tsx",
    "audit:runtime": "bun audit --prod --audit-level=high",
    "release:artifact": "bun run build && node scripts/release-artifact.mjs",
    "test:runtime": "node --test tests/sdk-runtime.test.mjs"
  },
  "dependencies": {
    "@openai/codex-security": "0.10.1",
    "@opencode/plugin": "2.3.2",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@opencode/cli": "2.4.1",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || ^26.0.0"
  },
  "description": "Codex Security scans, policy drafts and finding validation inside OpenCode V2.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strantalis/opencode-codex-security.git"
  },
  "files": [
    "src/",
    "dist/gui-experimental.cjs",
    "dist/tui.js",
    "LICENSE",
    "DISCLOSURE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/CONFIG.md"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.5"
}
