{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".runtime",
    "dist",
    "evidence",
    "coverage",
    "bun.lock",
    "*.tgz",
    ".claude"
  ]
}
